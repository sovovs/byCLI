# dashboard-be Recorder Local Service —— 环境变量模板
# 用法:cp .env.example .env,填好 .env(.env 已 gitignore,绝不提交真实密钥),然后:
#   cd <repo>; node --env-file=dashboard-be/.env dashboard-be/dist/server.js
# Node 20.6+ 原生支持 --env-file(本仓 Node 22),无需 dotenv 依赖。
#
# 说明:LLM 相关 key/baseURL **刻意用 RECORDER_LLM_* 项目命名空间**(不用 ANTHROPIC_API_KEY /
#   ANTHROPIC_BASE_URL)—— 避免与 Claude Code 等工具在 shell 里预置的同名 env 冲突
#   (node --env-file 不覆盖 shell 已存在的同名变量)。be 把这些值显式传给 SDK + authToken:null,
#   完全不读环境里的 ANTHROPIC_*,所以即便在带 Claude Code 环境的 shell 里也能正确指向你的网关。
#   注:--env-file 仍不覆盖 shell 里**已存在的 RECORDER_*/BYCLI_*/FEATURE_* 同名变量**;若你自己导出过,
#   用内联 `VAR=x node ...` 覆盖,或先 unset。自查:env | grep -E '^RECORDER_|^BYCLI_|FEATURE_'

# ── 同源托管前端工作台(真实 HTTP transport;不设则 API-only) ──
FEATURE_LOCALHOST_HTTP_UI=1
RECORDER_UI_DIST=./dashboard/dist

# ── daemon bridge / 端口 ──
BYCLI_DAEMON_PORT=19825
# RECORDER_PORT=19826

# ── 一体化录制 · embedded_iframe 模式(公开站页内嵌入;默认关,privileged/local recording mode) ──
# 开启后 dashboard 自己的 tab 可内嵌跨源目标站 iframe 录制(经 OOPIF flat autoAttach,带 frameSessionId)。
# CSP frame-src 随之放开(B+A 混合):flag on 且未配置下方 override → frame-src https:(填 URL 即录);
# 配置了 override → frame-src 只放这些 https origin(CI/企业收窄)。flag off → 无 frame-src(现状不变)。
# 仅 localhost、单用户本地工具;主 XSS 防线 script-src 'self'+nonce 未动。
FEATURE_EMBEDDED_IFRAME_RECORDING=0
# 可选 hardened override:逗号分隔的 https origin 白名单(不设=放行所有 https)。
# RECORDER_IFRAME_FRAME_SRC=https://juejin.cn,https://example.com

# ── LLM 合成(Post-M10;默认关。开启需 FEATURE_LLM_SYNTHESIS=1 且填 RECORDER_LLM_API_KEY) ──
FEATURE_LLM_SYNTHESIS=0
# 你自己的 Anthropic / 兼容网关 key —— 切勿提交真实值
RECORDER_LLM_API_KEY=
# 第三方 Anthropic 兼容网关(留空则用官方 api.anthropic.com)
RECORDER_LLM_BASE_URL=
RECORDER_LLM_MODEL=
# 单次 LLM 调用超时(ms,默认 180000=3min,范围 5000-600000)。SDK 默认 600s+2 retries,
# 第三方兼容网关偶发高延迟会挂满 10min 再抛;收窄让 rank/合成快速失败退回规则分/空模板。
RECORDER_LLM_TIMEOUT_MS=

# ── 其它(可选) ──
# LOG_LEVEL=info
# RECORDER_MAX_ACTIVE_SESSIONS=2
